{
  "model": {
    "hidden_dim": 128,
    "num_layers": 4,
    "heads": 4,
    "dropout": 0.12,
    "out_dim": 2,
    "use_norm": true
  },
  "training": {
    "epochs": 1000,
    "lr": 0.005,
    "weight_decay": 0.0005,
    "grad_clip": 1.0,
    "adam_eps": 1e-05,
    "log_every": 50
  },
  "save": {
    "save_dir": "models",
    "save_run": true,
    "filename": "gat.pt"
  }
}