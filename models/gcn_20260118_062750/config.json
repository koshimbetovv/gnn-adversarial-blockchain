{
  "model": {
    "hidden_dim": 128,
    "num_layers": 2,
    "dropout": 0.4,
    "out_dim": 2,
    "use_norm": true
  },
  "training": {
    "epochs": 200,
    "lr": 0.005,
    "weight_decay": 0.0005,
    "grad_clip": 1.0,
    "adam_eps": 1e-05,
    "log_every": 50,
    "loss": "ce",
    "use_class_weights": true,
    "focal_alpha": [
      1.0,
      2.0
    ],
    "focal_gamma": 2.0,
    "dev_frac": 0.1,
    "seed": 0,
    "tau_min": 0.05,
    "tau_max": 0.95,
    "tau_steps": 91
  },
  "save": {
    "save_dir": "models",
    "save_run": true,
    "filename": "gcn.pt"
  }
}